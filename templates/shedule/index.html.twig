{% extends 'base.html.twig' %}

{% block title %}Shedule index{% endblock %}

{% block body %}
    <h1>Shedule index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Room</th>
                <th>Time</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for shedule in shedules %}
            <tr>
                <td>{{ shedule.id }}</td>
                <td>{{ shedule.room }}</td>
                <td>{{ shedule.time ? shedule.time|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_shedule_show', {'id': shedule.id}) }}">show</a>
                    <a href="{{ path('app_shedule_edit', {'id': shedule.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_shedule_new') }}">Create new</a>
{% endblock %}
